# Google Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Frame Sampling Configuration
# How many frames to extract per second (0.5 = 1 frame every 5 seconds)
FRAME_SAMPLE_RATE=0.2

# Processing Configuration
# Number of videos to process in batch
BATCH_SIZE=5

# API Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=2

# Model Configuration
GEMINI_MODEL=gemini-1.5-pro

# Telegram Notification Configuration (Optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID by messaging your bot and visiting: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here
